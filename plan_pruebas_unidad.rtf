app.get("/api/reports/packages", async (req, res) => \{\par
  const format = String(req.query.format || "csv").toLowerCase();\par
  if (!["csv", "xlsx"].includes(format)) \{\par
    return res.status(400).json(\{ error: "Formato no soportado" \});\par
  \}\par
  const packages = await call(repo.listPackagesDetailed);\par
  const packagesWithHistory = await Promise.all(\par
    packages.map(async (pkg) => \{\par
      if (repo.getPackageDetailsById) \{\par
        const full = await call(repo.getPackageDetailsById, pkg.id);\par
        return full || pkg;\par
      \}\par
      return pkg;\par
    \})\par
  );\par
  const headers = [\par
    "ID",\par
    "Codigo",\par
    "Estado",\par
    "Descripcion",\par
    "Destino",\par
    "Distribuidora",\par
    "Razon Social Distribuidora",\par
    "Telefono Distribuidora",\par
    "Direccion Distribuidora",\par
    "Cliente",\par
    "Documento Cliente",\par
    "Telefono Cliente",\par
    "Email Cliente",\par
    "Direccion Cliente",\par
    "Sucursal Origen",\par
    "Direccion Sucursal Origen",\par
    "Sucursal Destino",\par
    "Direccion Sucursal Destino",\par
    "Creado En",\par
    "Ultima Actualizacion",\par
    "Ultima Observacion",\par
    "Historial Estados"\par
  ];\par
  const rows = packagesWithHistory.map((pkg) => \{\par
    const history = Array.isArray(pkg.historial) ? pkg.historial : [];\par
    const lastEntry = history.length ? history[history.length - 1] : null;\par
    const historyText = history\par
      .map(\par
        (item) =>\par
          `$\{item.estado\} ($\{formatDate(item.fechaHora) || "sin fecha"\})$\{\par
            item.observacion ? ` - $\{item.observacion\}` : ""\par
          \}`\par
      )\par
      .join(" | ");\par
    return [\par
      pkg.id,\par
      pkg.codigoSeguimiento,\par
      pkg.estadoActual,\par
      pkg.descripcion,\par
      pkg.destinoTexto,\par
      pkg.remitente?.nombre || "",\par
      pkg.remitente?.razonSocial || "",\par
      pkg.remitente?.telefono || "",\par
      pkg.remitente?.direccion || "",\par
      pkg.destinatario?.nombre || "",\par
      pkg.destinatario?.documento || "",\par
      pkg.destinatario?.telefono || "",\par
      pkg.destinatario?.email || "",\par
      pkg.destinatario?.direccion || "",\par
      pkg.sucursalOrigen?.nombre || "",\par
      pkg.sucursalOrigen?.direccion || "",\par
      pkg.sucursalDestino?.nombre || "",\par
      pkg.sucursalDestino?.direccion || "",\par
      formatDate(pkg.creadoEn),\par
      formatDate(lastEntry?.fechaHora),\par
      lastEntry?.observacion || "",\par
      historyText\par
    ];\par
  \});\par
  if (format === "xlsx") \{\par
    const worksheet = XLSX.utils.aoa_to_sheet([headers, ...rows]);\par
    const workbook = XLSX.utils.book_new();\par
    XLSX.utils.book_append_sheet(workbook, worksheet, "Paquetes");\par
    const buffer = XLSX.write(workbook, \{ type: "buffer", bookType: "xlsx" \});\par
    res.setHeader(\par
      "Content-Type",\par
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"\par
    );\par
    res.setHeader(\par
      "Content-Disposition",\par
      'attachment; filename="reporte-paquetes.xlsx"'\par
    );\par
    res.setHeader("Access-Control-Expose-Headers", "Content-Disposition");\par
    res.send(buffer);\par
    return;\par
  \}\par
\par
  const csv = [headers, ...rows]\par
    .map((row) => row.map(escapeCsv).join(","))\par
    .join("\\n");\par
\par
  res.setHeader("Content-Type", "text/csv; charset=utf-8");\par
  res.setHeader(\par
    "Content-Disposition",\par
    'attachment; filename="reporte-paquetes.csv"'\par
  );\par
  res.setHeader("Access-Control-Expose-Headers", "Content-Disposition");\par
  res.send(`\\uFEFF$\{csv\}`);\par
\});\par
