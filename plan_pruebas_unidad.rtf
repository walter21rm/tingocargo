  it("crea usuarios operador y repartidor", async () => \{\par
    const roles = await request(baseUrl, "/api/roles", \{\par
      headers: \{ Authorization: `Bearer $\{token\}` \}\par
    \});\par
    const branches = await request(baseUrl, "/api/branches", \{\par
      headers: \{ Authorization: `Bearer $\{token\}` \}\par
    \});\par
    assert.ok(Array.isArray(roles.body));\par
    assert.ok(Array.isArray(branches.body));\par
\par
    const operatorRole = roles.body.find((r) => r.nombre === "Operador log\'edstico");\par
    const courierRole = roles.body.find((r) => r.nombre === "Repartidor");\par
    assert.ok(operatorRole?.id);\par
    assert.ok(courierRole?.id);\par
\par
    const resOperator = await request(baseUrl, "/api/users", \{\par
      method: "POST",\par
      headers: \{ ...jsonHeaders, Authorization: `Bearer $\{token\}` \},\par
      body: JSON.stringify(\{\par
        nombre: "Operador Test",\par
        email: "operador@test.com",\par
        telefono: "999888777",\par
        rolId: operatorRole.id,\par
        sucursalId: branches.body[0]?.id,\par
        password: "operador123",\par
        activo: true\par
      \})\par
    \});\par
    assert.equal(resOperator.status, 201);\par
    operatorUser = resOperator.body;\par
    assert.ok(operatorUser?.id);\par
\par
    const resCourier = await request(baseUrl, "/api/users", \{\par
      method: "POST",\par
      headers: \{ ...jsonHeaders, Authorization: `Bearer $\{token\}` \},\par
      body: JSON.stringify(\{\par
        nombre: "Repartidor Test",\par
        email: "repartidor@test.com",\par
        telefono: "988776655",\par
        rolId: courierRole.id,\par
        sucursalId: branches.body[0]?.id,\par
        password: "repartidor123",\par
        activo: true\par
      \})\par
    \});\par
    assert.equal(resCourier.status, 201);\par
    courierUser = resCourier.body;\par
    assert.ok(courierUser?.id);\par
  \});\par
