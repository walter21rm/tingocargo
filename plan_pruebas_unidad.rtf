import assert from "node:assert/strict";\par
import \{ after, before, describe, it \} from "node:test";\par
\par
const jsonHeaders = \{ "Content-Type": "application/json" \};\par
\par
const request = async (baseUrl, path, options = \{\}) => \{\par
  const response = await fetch(`$\{baseUrl\}$\{path\}`, options);\par
  const bodyText = await response.text();\par
  let body = null;\par
  try \{\par
    body = bodyText ? JSON.parse(bodyText) : null;\par
  \} catch \{\par
    body = bodyText;\par
  \}\par
  return \{ status: response.status, body, headers: response.headers \};\par
\};\par
\par
describe("API log\'edstica", () => \{\par
  let app;\par
  let server;\par
  let baseUrl;\par
  let token;\par
  let operatorToken;\par
  let courierToken;\par
  let operatorUser;\par
  let courierUser;\par
  let packageIdForCourier;\par
\par
  before(async () => \{\par
    process.env.USE_DB = "false";\par
    process.env.ADMIN_USER = "admin";\par
    process.env.ADMIN_PASS = "admin123";\par
    const module = await import("../src/server.js");\par
    app = module.app;\par
    server = app.listen(0);\par
    const \{ port \} = server.address();\par
    baseUrl = `http://127.0.0.1:$\{port\}`;\par
  \});\par
\par
  after(async () => \{\par
    if (server) \{\par
      server.close();\par
    \}\par
  \});\par
\pard\f1\fs20\par

\pard\li200\f1\fs20\b Prueba 1: login con admin env retorna token\b0\par
\pard\li200\f0\fs16
  it("login con admin env retorna token", async () => \{\par
    const res = await request(baseUrl, "/api/auth/login", \{\par
      method: "POST",\par
      headers: jsonHeaders,\par
      body: JSON.stringify(\{ usuario: "admin", password: "admin123" \})\par
    \});\par
    assert.equal(res.status, 200);\par
    assert.ok(res.body?.token);\par
    token = res.body.token;\par
  \});\par
\pard\f1\fs20\par

