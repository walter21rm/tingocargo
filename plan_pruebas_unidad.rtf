    return res.status(400).json(\{ error: "Sucursal inv\'e1lida" \});\par
  \}\par
  const passwordHash = password ? await bcrypt.hash(password, 10) : null;\par
  const updated = await call(repo.updateUser, id, \{\par
    nombre,\par
    email,\par
    telefono,\par
    rolId,\par
    sucursalId,\par
    activo,\par
    passwordHash\par
  \});\par
  if (!updated) \{\par
    return res.status(400).json(\{ error: "No se pudo actualizar" \});\par
  \}\par
  res.json(updated);\par
\});\par
