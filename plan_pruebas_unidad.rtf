\pard\li200\f1\fs20\b M\'e9todo 10: POST /api/auth/login\b0\par
\pard\li200\f0\fs16
app.post("/api/auth/login", (req, res) => \{\par
  const \{ usuario, password \} = req.body || \{\};\par
  if (!usuario || !password) \{\par
    return res.status(400).json(\{ error: "Usuario y contrase\'f1a requeridos" \});\par
  \}\par
  if (usuario === adminUser && password === adminPass) \{\par
    const token = crypto.randomUUID();\par
    authTokens.set(token, \{\par
      id: "admin-env",\par
      nombre: "Administrador Sistema",\par
      email: adminUser,\par
      rolId: null,\par
      roleName: "Administrador",\par
      sucursalId: null,\par
      activo: true\par
    \});\par
    return res.json(\{\par
      token,\par
      user: \{\par
        id: "admin-env",\par
        nombre: "Administrador Sistema",\par
        email: adminUser,\par
        rolId: null,\par
        roleName: "Administrador",\par
        sucursalId: null,\par
        activo: true\par
      \}\par
    \});\par
  \}\par
  return call(repo.getUserByEmail, usuario)\par
    .then(async (user) => \{\par
      if (!user || user.activo === false) \{\par
        throw new Error("Credenciales inv\'e1lidas");\par
      \}\par
      const ok = await bcrypt.compare(\par
        password,\par
        user.password_hash || user.passwordHash || ""\par
      );\par
      if (!ok) \{\par
        throw new Error("Credenciales inv\'e1lidas");\par
      \}\par
      const roleId = user.rol_id || user.rolId;\par
      const role = roleId ? await call(repo.getRoleById, roleId) : null;\par
      const roleName = role?.nombre || null;\par
      const token = crypto.randomUUID();\par
      authTokens.set(token, sanitizeUser(user, roleName));\par
      return res.json(\{ token, user: sanitizeUser(user, roleName) \});\par
    \})\par
    .catch(() => res.status(401).json(\{ error: "Credenciales inv\'e1lidas" \}));\par
\});\par
\pard\f1\fs20\par

