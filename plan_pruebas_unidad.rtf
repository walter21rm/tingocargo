\pard\li200\f1\fs20\b M\'e9todo 16: POST /api/packages\b0\par
\pard\li200\f0\fs16
app.post("/api/packages", async (req, res) => \{\par
  if (req.authUser?.roleName === "Repartidor") \{\par
    return res.status(403).json(\{ error: "No autorizado" \});\par
  \}\par
  const \{\par
    remitenteId,\par
    destinatarioId,\par
    sucursalOrigenId,\par
    destinoTexto,\par
    operadorId,\par
    repartidorId\par
  \} = req.body;\par
  if (!remitenteId || !destinatarioId || !sucursalOrigenId || !destinoTexto) \{\par
    return res.status(400).json(\{\par
      error:\par
        "remitenteId, destinatarioId, sucursalOrigenId y destinoTexto son requeridos"\par
    \});\par
  \}\par
  const remitente = await call(repo.getDistributorById, remitenteId);\par
  const destinatario = await call(repo.getClientById, destinatarioId);\par
  if (!remitente || !destinatario) \{\par
    return res.status(400).json(\{ error: "Distribuidora o cliente inv\'e1lido" \});\par
  \}\par
  const origen = await call(repo.getBranchById, sucursalOrigenId);\par
  if (!origen) \{\par
    return res.status(400).json(\{ error: "Sucursal inv\'e1lida" \});\par
  \}\par
  let operadorFinal = operadorId || null;\par
  if (!operadorFinal && req.authUser?.roleName === "Operador log\'edstico") \{\par
    operadorFinal = req.authUser.id;\par
  \}\par
  if (operadorFinal) \{\par
    const operador = await call(repo.getUserById, operadorFinal);\par
    if (!operador) \{\par
      return res.status(400).json(\{ error: "Operador inv\'e1lido" \});\par
    \}\par
    const role = await call(repo.getRoleById, operador.rol_id || operador.rolId);\par
    if (role?.nombre !== "Operador log\'edstico") \{\par
      return res.status(400).json(\{ error: "Operador inv\'e1lido" \});\par
    \}\par
  \}\par
  if (repartidorId) \{\par
    const repartidor = await call(repo.getUserById, repartidorId);\par
    if (!repartidor) \{\par
      return res.status(400).json(\{ error: "Repartidor inv\'e1lido" \});\par
    \}\par
    const role = await call(\par
      repo.getRoleById,\par
      repartidor.rol_id || repartidor.rolId\par
    );\par
    if (role?.nombre !== "Repartidor") \{\par
      return res.status(400).json(\{ error: "Repartidor inv\'e1lido" \});\par
    \}\par
  \}\par
  const pkg = await call(repo.createPackage, \{\par
    ...req.body,\par
    operadorId: operadorFinal\par
  \});\par
  res.status(201).json(pkg);\par
\});\par
\pard\f1\fs20\par

\pard\li200\f1\fs20\b M\'e9todo 17: PATCH /api/packages/:id/status\b0\par
\pard\li200\f0\fs16
app.patch("/api/packages/:id/status", async (req, res) => \{\par
  const \{ id \} = req.params;\par
  const \{ estado, observacion \} = req.body;\par
  const statuses = await call(repo.listStatuses);\par
  if (!estado || !statuses.includes(estado)) \{\par
    return res.status(400).json(\{ error: "Estado inv\'e1lido" \});\par
  \}\par
  const existing = await call(repo.getPackageById, id);\par
  if (!existing) \{\par
    return res.status(404).json(\{ error: "Paquete no encontrado" \});\par
  \}\par
  if (req.authUser?.roleName === "Repartidor") \{\par
    const repartidorId = existing.repartidor_id || existing.repartidorId;\par
    if (repartidorId !== req.authUser.id) \{\par
      return res.status(403).json(\{ error: "No autorizado" \});\par
    \}\par
    if (estado !== "Entregado" && estado !== "Intento fallido") \{\par
      return res.status(403).json(\{ error: "Acci\'f3n no permitida" \});\par
    \}\par
  \}\par
  const pkg = await call(repo.updatePackageStatus, id, estado, observacion);\par
  res.json(pkg);\par
\});\par
\pard\f1\fs20\par

