    return res.status(404).json(\{ error: "Usuario no encontrado" \});\par
  \}\par
  if (rolId && !(await call(repo.getRoleById, rolId))) \{\par
    return res.status(400).json(\{ error: "Rol inv\'e1lido" \});\par
