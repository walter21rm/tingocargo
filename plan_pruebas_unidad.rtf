\pard\li200\f1\fs20\b M\'e9todo 1: sanitizeUser (Funci\'f3n auxiliar)\b0\par
\pard\li200\f0\fs16
const sanitizeUser = (user, roleName) => (\{\par
  id: user.id,\par
  nombre: user.nombre,\par
  email: user.email,\par
  rolId: user.rol_id || user.rolId || null,\par
  roleName: roleName || null,\par
  sucursalId: user.sucursal_id || user.sucursalId || null,\par
  activo: user.activo\par
\});\par
\pard\f1\fs20\par

\pard\li200\f1\fs20\b M\'e9todo 2: requireAdmin (Middleware de autorizaci\'f3n)\b0\par
\pard\li200\f0\fs16
const requireAdmin = (req, res, next) => \{\par
  const roleName = req.authUser?.roleName;\par
  if (roleName !== "Administrador") \{\par
    return res.status(403).json(\{ error: "Solo administrador" \});\par
  \}\par
  return next();\par
\};\par
\pard\f1\fs20\par

\pard\li200\f1\fs20\b M\'e9todo 3: isPublicRoute (Funci\'f3n auxiliar)\b0\par
\pard\li200\f0\fs16
const isPublicRoute = (req) => \{\par
  if (!req.path.startsWith("/api")) return true;\par
  if (req.path === "/api/health") return true;\par
  if (req.path === "/api/auth/login") return true;\par
  return req.path.startsWith("/api/tracking/");\par
\};\par
\pard\f1\fs20\par

\pard\li200\f1\fs20\b M\'e9todo 4: Middleware de autenticaci\'f3n (app.use)\b0\par
\pard\li200\f0\fs16
app.use((req, res, next) => \{\par
  if (isPublicRoute(req)) return next();\par
  const authHeader = req.headers.authorization || "";\par
  const token = authHeader.startsWith("Bearer ")\par
    ? authHeader.slice(7).trim()\par
    : "";\par
  if (!token || !authTokens.has(token)) \{\par
    return res.status(401).json(\{ error: "No autorizado" \});\par
  \}\par
  req.authUser = authTokens.get(token);\par
  return next();\par
\});\par
\pard\f1\fs20\par

\pard\li200\f1\fs20\b M\'e9todo 5: formatDate (Funci\'f3n auxiliar)\b0\par
\pard\li200\f0\fs16
const formatDate = (value) => \{\par
  if (!value) return "";\par
  const date = new Date(value);\par
  if (Number.isNaN(date.getTime())) return "";\par
  return new Intl.DateTimeFormat("es-PE", \{\par
    day: "2-digit",\par
    month: "2-digit",\par
    year: "numeric",\par
    hour: "2-digit",\par
    minute: "2-digit",\par
    timeZone: "America/Lima",\par
    hour12: true\par
  \}).format(date);\par
\};\par
\pard\f1\fs20\par

\pard\li200\f1\fs20\b M\'e9todo 6: escapeCsv (Funci\'f3n auxiliar)\b0\par
\pard\li200\f0\fs16
const escapeCsv = (value) => \{\par
  if (value === null || value === undefined) return "";\par
  const str = String(value);\par
  return `"$\{str.replace(/"/g, '""')\}"`;\par
\};\par
\pard\f1\fs20\par

\pard\li200\f1\fs20\b M\'e9todo 7: ensureRoles (Inicializaci\'f3n de roles)\b0\par
\pard\li200\f0\fs16
const ensureRoles = async () => \{\par
  if (!repo.listRoles || !repo.createRole) return;\par
  const required = ["Administrador", "Operador log\'edstico", "Repartidor"];\par
  const roles = await call(repo.listRoles);\par
  const existing = new Set(roles.map((role) => role.nombre));\par
  for (const name of required) \{\par
    if (!existing.has(name)) \{\par
      await call(repo.createRole, name);\par
    \}\par
  \}\par
\};\par
\pard\f1\fs20\par

\pard\li200\f1\fs20\b M\'e9todo 8: ensureAdminUser (Inicializaci\'f3n de admin)\b0\par
\pard\li200\f0\fs16
const ensureAdminUser = async () => \{\par
  try \{\par
    if (!repo.getUserByEmail || !repo.createUser || !repo.listRoles) return;\par
    await ensureRoles();\par
    const existing = await call(repo.getUserByEmail, seedAdminEmail);\par
    if (existing) return;\par
    let roles = await call(repo.listRoles);\par
    let adminRole =\par
      roles.find((role) => role.nombre === "Administrador") || roles[0];\par
    if (!adminRole && repo.createRole) \{\par
      try \{\par
        await call(repo.createRole, "Administrador");\par
        roles = await call(repo.listRoles);\par
        adminRole =\par
          roles.find((role) => role.nombre === "Administrador") || roles[0];\par
      \} catch (err) \{\par
        console.error("No se pudo crear el rol Administrador:", err.message);\par
      \}\par
    \}\par
    const passwordHash = await bcrypt.hash(seedAdminPass, 10);\par
    await call(repo.createUser, \{\par
      nombre: seedAdminName,\par
      email: seedAdminEmail,\par
      rolId: adminRole?.id,\par
      sucursalId: null,\par
      activo: true,\par
      passwordHash\par
    \});\par
  \} catch (err) \{\par
    console.error("No se pudo crear el admin inicial:", err.message);\par
  \}\par
\};\par
\pard\f1\fs20\par

