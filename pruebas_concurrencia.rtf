import assert from "node:assert/strict";\par
import \{ after, before, describe, it \} from "node:test";\par
\par
const jsonHeaders = \{ "Content-Type": "application/json" \};\par
\par
const request = async (baseUrl, path, options = \{\}) => \{\par
  const response = await fetch(`$\{baseUrl\}$\{path\}`, options);\par
  const bodyText = await response.text();\par
  let body = null;\par
  try \{\par
    body = bodyText ? JSON.parse(bodyText) : null;\par
  \} catch \{\par
    body = bodyText;\par
  \}\par
  return \{ status: response.status, body \};\par
\};\par
\par
const runConcurrent = async (count, fn) => \{\par
  const startedAt = Date.now();\par
  const results = await Promise.all(\par
    Array.from(\{ length: count \}, (_, index) => fn(index))\par
  );\par
  const elapsedMs = Date.now() - startedAt;\par
  return \{ results, elapsedMs \};\par
\};\par
\par
describe("Pruebas de concurrencia API log\'edstica", () => \{\par
  let app;\par
  let server;\par
  let baseUrl;\par
  let adminToken;\par
  const createdPackageIds = [];\par
\par
  before(async () => \{\par
    process.env.USE_DB = "false";\par
    process.env.ADMIN_USER = "admin";\par
    process.env.ADMIN_PASS = "admin123";\par
    const module = await import("../src/server.js");\par
    app = module.app;\par
    server = app.listen(0);\par
    const \{ port \} = server.address();\par
    baseUrl = `http://127.0.0.1:$\{port\}`;\par
  \});\par
\par
  after(async () => \{\par
    if (server) server.close();\par
  \});\par
\par
  it("concurrencia de login admin (30 requests paralelos)", async () => \{\par
    const \{ results, elapsedMs \} = await runConcurrent(30, async () =>\par
      request(baseUrl, "/api/auth/login", \{\par
        method: "POST",\par
        headers: jsonHeaders,\par
        body: JSON.stringify(\{ usuario: "admin", password: "admin123" \})\par
      \})\par
    );\par
\par
    const ok = results.filter((r) => r.status === 200);\par
    assert.equal(ok.length, 30, "Todos los logins concurrentes deben responder 200");\par
    assert.ok(\par
      ok.every((r) => typeof r.body?.token === "string" && r.body.token.length > 10),\par
      "Todas las respuestas deben incluir token"\par
    );\par
    adminToken = ok[0].body.token;\par
    assert.ok(adminToken, "Debe quedar un token admin para pruebas siguientes");\par
    assert.ok(elapsedMs < 15000, `Tiempo elevado en login concurrente: $\{elapsedMs\}ms`);\par
  \});\par
\par
  it("concurrencia de tracking p\'fablico (50 requests paralelos)", async () => \{\par
    const \{ results, elapsedMs \} = await runConcurrent(50, async () =>\par
      request(baseUrl, "/api/tracking/TM-2026-0001")\par
    );\par
\par
    const ok = results.filter((r) => r.status === 200);\par
    assert.equal(ok.length, 50, "Todos los tracking concurrentes deben responder 200");\par
    assert.ok(\par
      ok.every((r) => r.body?.codigoSeguimiento === "TM-2026-0001"),\par
      "El c\'f3digo de seguimiento debe coincidir en todas las respuestas"\par
    );\par
    assert.ok(elapsedMs < 15000, `Tiempo elevado en tracking concurrente: $\{elapsedMs\}ms`);\par
  \});\par
\par
  it("concurrencia en listado autenticado de paquetes (40 requests paralelos)", async () => \{\par
    const \{ results, elapsedMs \} = await runConcurrent(40, async () =>\par
      request(baseUrl, "/api/packages/expanded", \{\par
        headers: \{ Authorization: `Bearer $\{adminToken\}` \}\par
      \})\par
    );\par
\par
    const ok = results.filter((r) => r.status === 200);\par
    assert.equal(ok.length, 40, "Todos los listados concurrentes deben responder 200");\par
    assert.ok(\par
      ok.every((r) => Array.isArray(r.body)),\par
      "Todas las respuestas deben devolver un array"\par
    );\par
    assert.ok(elapsedMs < 15000, `Tiempo elevado en listado concurrente: $\{elapsedMs\}ms`);\par
  \});\par
\par
  it("concurrencia de creaci\'f3n de paquetes (20 requests paralelos)", async () => \{\par
    const \{ results, elapsedMs \} = await runConcurrent(20, async (i) =>\par
      request(baseUrl, "/api/packages", \{\par
        method: "POST",\par
        headers: \{ ...jsonHeaders, Authorization: `Bearer $\{adminToken\}` \},\par
        body: JSON.stringify(\{\par
          remitenteId: "d1",\par
          destinatarioId: "c1",\par
          sucursalOrigenId: "b1",\par
          destinoTexto: `Jr. Concurrencia $\{i + 1\}`,\par
          descripcion: `Paquete paralelo $\{i + 1\}`\par
        \})\par
      \})\par
    );\par
\par
    const created = results.filter((r) => r.status === 201);\par
    assert.equal(created.length, 20, "Todos los paquetes concurrentes deben crearse");\par
    created.forEach((r) => \{\par
      if (r.body?.id) createdPackageIds.push(r.body.id);\par
    \});\par
    assert.equal(createdPackageIds.length, 20, "Se deben capturar 20 IDs de paquetes");\par
    assert.ok(elapsedMs < 15000, `Tiempo elevado en creaci\'f3n concurrente: $\{elapsedMs\}ms`);\par
  \});\par
\par
  it("concurrencia de actualizaci\'f3n de estado en paquetes creados", async () => \{\par
    const \{ results, elapsedMs \} = await runConcurrent(createdPackageIds.length, async (i) =>\par
      request(baseUrl, `/api/packages/$\{createdPackageIds[i]\}/status`, \{\par
        method: "PATCH",\par
        headers: \{ ...jsonHeaders, Authorization: `Bearer $\{adminToken\}` \},\par
        body: JSON.stringify(\{\par
          estado: "En Tr\'e1nsito",\par
          observacion: "Actualizaci\'f3n concurrente"\par
        \})\par
      \})\par
    );\par
\par
    const ok = results.filter((r) => r.status === 200);\par
    assert.equal(ok.length, createdPackageIds.length, "Todas las actualizaciones deben responder 200");\par
    assert.ok(\par
      ok.every((r) => r.body?.estadoActual === "En Tr\'e1nsito"),\par
      "El estado final debe quedar en En Tr\'e1nsito"\par
    );\par
    assert.ok(elapsedMs < 15000, `Tiempo elevado en actualizaci\'f3n concurrente: $\{elapsedMs\}ms`);\par
  \});\par
\});\par
\par
